{
  "name": "dsh-task-tree",
  "version": "0.1.0",
  "description": "会话任务树：把一件活摆成能看懂、也能打断纠正的方向图——现在做到哪、这活替谁做、旁边还有哪几件；下一级替上一级拿验收。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./invariant": "./invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "invariant.js",
    "cordis.patch.yml",
    "assets",
    "src",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "task-tree",
    "planning",
    "ui"
  ],
  "author": "taoziliyouchong",
  "license": "MIT",
  "scripts": {
    "check": "node --check index.js && node --check invariant.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taoziliyouchong/dsh-evolve-preset"
  },
  "homepage": "https://github.com/taoziliyouchong/dsh-evolve-preset#readme",
  "bugs": {
    "url": "https://github.com/taoziliyouchong/dsh-evolve-preset/issues"
  }
}
