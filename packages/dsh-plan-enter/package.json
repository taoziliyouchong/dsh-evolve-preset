{
  "name": "dsh-plan-enter",
  "version": "0.1.0",
  "description": "给模型一个 enter_plan_mode 工具：自己把当前会话切进计划模式，先只读规划、再用 exit_plan_mode 交计划等你批。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plan-mode"
  ],
  "author": "taoziliyouchong",
  "license": "MIT",
  "scripts": {
    "check": "node --check index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taoziliyouchong/dsh-evolve-preset"
  },
  "homepage": "https://github.com/taoziliyouchong/dsh-evolve-preset#readme",
  "bugs": {
    "url": "https://github.com/taoziliyouchong/dsh-evolve-preset/issues"
  }
}
